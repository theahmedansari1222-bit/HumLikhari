# Local Supabase CLI environment only. Never commit real credentials.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=REPLACE_WITH_LOCAL_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_LOCAL_SERVICE_ROLE_KEY
# Comma-separated list of web origins allowed to call the functions from a browser.
HUM_LIKHARI_ALLOWED_ORIGIN=http://localhost:8080
# Shared secret for the push scheduler (>= 24 random characters: openssl rand -hex 32).
PUSH_DISPATCH_SECRET=REPLACE_WITH_LONG_RANDOM_VALUE
# Configure only when Firebase Cloud Messaging is enabled.
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"REPLACE_ME","private_key_id":"REPLACE_ME","private_key":"-----BEGIN PRIVATE KEY-----\\nREPLACE_ME\\n-----END PRIVATE KEY-----\\n","client_email":"REPLACE_ME","client_id":"REPLACE_ME"}
